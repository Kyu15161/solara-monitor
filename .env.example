DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/solar
APP_URL=http://127.0.0.1:3000
DESSMONITOR_MODE=mock
DESSMONITOR_SYNC_INTERVAL_SECONDS=120
FRESHNESS_DELAYED_SECONDS=300
FRESHNESS_OFFLINE_SECONDS=900
# Generate with npm run setup. Never use example keys in production.
ENCRYPTION_KEY=
# Set after confirming your account's endpoint and app identity with DESSMonitor.
DESSMONITOR_BASE_URL=https://api.dessmonitor.com/public/
DESSMONITOR_DEFAULT_SOURCE=1
DESSMONITOR_APP_ID=
DESSMONITOR_APP_VERSION=1.0.0
# Comma-separated, operator-reviewed enum control IDs. Empty disables live writes.
DESSMONITOR_ALLOWED_CONTROL_IDS=
ENABLE_DEMO=true
# Optional password reset delivery. HTTPS endpoint must implement the documented mail adapter contract.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=
